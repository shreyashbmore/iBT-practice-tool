# Backend
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
# Deepgram model defaults (verify against https://developers.deepgram.com)
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
